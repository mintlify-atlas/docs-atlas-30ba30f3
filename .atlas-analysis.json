  "keyFeatures": [
    "Real-time AI chat with SSE streaming and multi-session management",
    "Multi-platform channel configuration (Telegram, Discord, Slack, WhatsApp, Matrix, Feishu, WeChat, WeCom)",
    "Scheduled cron jobs with create/edit/pause/resume/delete",
    "Usage analytics with token tracking, cost estimation, and 30-day trend charts",
    "Model management with auto-discovery from credential pool and custom provider support",
    "Skills & memory browser with user notes and profile management",
    "Integrated web terminal powered by node-pty and xterm.js",
    "Structured log viewer with level/file/keyword filtering",
    "BFF (Backend-for-Frontend) server proxying Hermes Agent gateway",
    "Internationalization support (English and Chinese)"
  ],
  "publicApiSurface": [
